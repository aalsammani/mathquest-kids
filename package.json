{
  "name": "mathquest-kids",
  "private": true,
  "version": "2.0.0-rc.1",
  "description": "MathQuest Kids — a local-first, reasoning-centered math learning app with four learning levels.",
  "license": "MIT",
  "author": "Abdallah Alsammani",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages && node scripts/verify-pages-build.mjs dist-pages",
    "verify:pages": "node scripts/verify-pages-build.mjs dist-pages",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "build:e2e:pages": "vite build --mode e2e-pages --outDir dist-e2e-pages",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:pages": "node scripts/serve-pages.mjs dist-pages /mathquest-kids/ 4175",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:pages": "npm run build:pages && npm run build:e2e:pages && playwright test --config playwright.pages.config.ts",
    "validate:math": "vitest run --config vitest.validation.config.ts",
    "test:all": "npm run typecheck && npm run test && npm run validate:math && npm run test:e2e",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "assets:native": "node scripts/make-icons.mjs && capacitor-assets generate --assetPath resources --android --ios --iconBackgroundColor \"#FFC53D\" --iconBackgroundColorDark \"#1B2156\" --splashBackgroundColor \"#EAF8FF\" --splashBackgroundColorDark \"#1B2156\"",
    "smoke": "vite build --mode e2e --outDir dist-e2e && node scripts/smoke.mjs",
    "audit:legacy": "node scripts/audit-legacy.mjs",
    "docs:curriculum": "vitest run --config vitest.debug.config.ts tests/validation/debug/gen-curriculum.test.ts",
    "probe:issues": "vitest run --config vitest.debug.config.ts tests/validation/debug/issues.test.ts --silent=false",
    "probe:samples": "vitest run --config vitest.debug.config.ts tests/validation/debug/samples.test.ts --silent=false"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
